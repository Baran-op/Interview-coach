# Optional. By default the backend uses your Claude Code login (run `claude login`
# once: it opens the browser). Only set a token if you can't log in that way:
# get one with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional: pin the interviewer model (leave empty to use your plan's default).
# INTERVIEWER_MODEL=

# Never set ANTHROPIC_API_KEY here or in your shell: it would bill the API
# instead of your subscription, and the backend refuses to start if it is set.
